# Sample systemd unit — copy to /etc/systemd/system/sonicroom.service and adjust
# the paths. Deliberately carries NO configuration: everything the server reads
# (PORT, ANNOUNCED_IP/ANNOUNCED_IP6, INSTANCE_NAME, ...) lives in the gitignored
# .env at the repo root, so this file is safe to commit and there is exactly one
# place to edit. See .env.example.
#
# Note: real environment variables win over .env — if you do add Environment=
# lines here, they override the .env value rather than the other way round.

[Unit]
Description=SonicRoom audio conferencing server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sonicroom
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/sonicroom
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
