# Copy to .env (gitignored) and adjust. Loaded at server startup from the repo
# root by server/src/index.ts. These are operator-only settings, never shown in
# the app UI.

# HTTP/signaling port (default 3100).
# PORT=3100

# Set to "production" for production runs.
# NODE_ENV=production

# --- Announced ICE addresses (how peers reach this server's media) -----------
#
# The address(es) mediasoup hands out as ICE candidates. Both accept a LIST
# (comma- or space-separated) and announce one candidate per entry, so a server
# that is reachable at more than one address can advertise all of them and let
# ICE pick the one that works.
#
#   VPS with a public IP      ANNOUNCED_IP=203.0.113.10
#   Home server behind NAT    ANNOUNCED_IP=203.0.113.10,192.168.1.50
#
# The second case matters: most consumer routers don't hairpin NAT, so people on
# the same LAN as a home-hosted server cannot reach it through its public IP —
# announcing the LAN address alongside the public one is what lets them connect.
# A hostname works too (e.g. a dynamic-DNS name).
# ANNOUNCED_IP=203.0.113.10
# ANNOUNCED_IP6=2001:db8::1

# Instead of hardcoding a DHCP-assigned LAN address above, set this to true to
# also announce this host's own interface addresses (loopback and IPv6
# link-local excluded). Handy for home/LAN instances. Note each announced
# address costs one extra UDP port per transport out of the 40000-40100 range
# (two transports per peer), so don't announce more than you need.
# ANNOUNCE_LOCAL_IPS=false

# Display name of this instance — shown as the app title in the lobby heading
# and the browser tab. Rebrand your deployment by changing this and restarting
# the server (no rebuild needed). Defaults to "SonicRoom" when unset.
INSTANCE_NAME=SonicRoom

# Off-box "noty" notifications (server/src/notify.ts): when a PUBLIC room is
# created or someone joins one, send a notification to a noty daemon — a raw-TCP
# service that speaks it aloud (screen-reader / TTS) and plays a sound.
# Disabled unless NOTY_ENABLED is truthy, so leaving this file as-is is a no-op.
NOTY_ENABLED=false
NOTY_HOST=win.gomsen.com
NOTY_PORT=1337
NOTY_SENDER=sonicroom

# Shared notes (server/src/notes.ts): base URL of a NoteLab instance
# (https://github.com/… — accessible realtime collaborative markdown). Set it to
# enable the in-call "Notes" button / Alt+N, which creates ONE collaborative note
# per room and opens it in a new tab. Unset (default) hides the button.
# NOTELAB_URL=https://notelab.example.com
